@model AndrewProg30000Assignment2.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h1>Delete Vehicle</h1>
<h3>Are you sure you want to delete this vehicle?</h3>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Make)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Make)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Type)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Type)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.PurchaseDate)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.PurchaseDate)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Year)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Year)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Price)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Price)</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.VehicleId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
</form>